{
  "name": "exstream.js",
  "version": "0.27.0",
  "description": "Composable streaming ETL pipelines for JavaScript",
  "keywords": [
    "async",
    "backpressure",
    "csv",
    "etl",
    "pipeline",
    "stream",
    "streaming"
  ],
  "homepage": "https://exstream-js.github.io/",
  "bugs": {
    "url": "https://github.com/micheletriaca/exstream/issues"
  },
  "license": "MIT",
  "author": "Michele Triaca",
  "repository": {
    "type": "git",
    "url": "https://github.com/micheletriaca/exstream"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "main": "src/index.js",
  "browser": {
    "./src/platform-runtime.js": "./src/web-runtime.js",
    "./src/node-runtime.js": "./src/web-runtime.js"
  },
  "exports": {
    ".": {
      "browser": "./src/browser.js",
      "node": "./src/index.js",
      "default": "./src/browser.js"
    },
    "./node": "./src/index.js",
    "./web": "./src/browser.js"
  },
  "scripts": {
    "test": "vitest run --coverage",
    "ci:test": "vitest run --coverage",
    "test:browser": "node test/browser/run-browser-tests.mjs",
    "benchmark": "vitest bench --run test/benchmarks/performance-baseline.bench.mjs",
    "benchmark:csv:memory": "node test/benchmarks/streaming-csv.mjs --memory-scaling",
    "benchmark:csv:stream": "node test/benchmarks/streaming-csv.mjs",
    "benchmark:update": "node test/benchmarks/update-baseline.mjs",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write --ignore-path .oxfmtignore .",
    "format:check": "oxfmt --check --ignore-path .oxfmtignore ."
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.10",
    "csv-parse": "7.0.2",
    "csv-stringify": "6.8.3",
    "fast-csv": "5.0.7",
    "highland": "2.13.5",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}