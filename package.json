{
  "name": "exstream.js",
  "version": "1.0.1",
  "description": "Composable streaming ETL pipelines for JavaScript",
  "keywords": [
    "async",
    "backpressure",
    "csv",
    "etl",
    "pipeline",
    "stream",
    "streaming"
  ],
  "homepage": "https://exstream-js.github.io/",
  "bugs": {
    "url": "https://github.com/micheletriaca/exstream/issues"
  },
  "license": "MIT",
  "author": "Michele Triaca",
  "repository": {
    "type": "git",
    "url": "https://github.com/micheletriaca/exstream"
  },
  "files": [
    "dist",
    "src",
    "types",
    "CHANGELOG.md",
    "MIGRATION.md",
    "README.md",
    "SUPPORT.md",
    "LICENSE"
  ],
  "main": "src/index.js",
  "browser": {
    "./src/platform-runtime.js": "./src/web-runtime.js",
    "./src/node-runtime.js": "./src/web-runtime.js"
  },
  "types": "types/index.d.ts",
  "unpkg": "dist/exstream.iife.min.js",
  "jsdelivr": "dist/exstream.iife.min.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "browser": {
        "import": "./src/browser.mjs",
        "require": "./src/browser.js"
      },
      "node": {
        "import": "./src/index.mjs",
        "require": "./src/index.js"
      },
      "import": "./src/browser.mjs",
      "require": "./src/browser.js"
    },
    "./core": {
      "types": "./types/core.d.ts",
      "import": "./src/browser.mjs",
      "require": "./src/browser.js"
    },
    "./node": {
      "types": "./types/node.d.ts",
      "import": "./src/index.mjs",
      "require": "./src/index.js"
    },
    "./web": {
      "types": "./types/web.d.ts",
      "import": "./src/browser.mjs",
      "require": "./src/browser.js"
    }
  },
  "scripts": {
    "build:browser": "node scripts/build-browser.mjs",
    "prepack": "npm run build:browser",
    "test": "vitest run --coverage && npm run test:types",
    "ci:test": "vitest run --coverage && npm run test:types",
    "test:browser": "node test/browser/run-browser-tests.mjs",
    "test:csv:fuzz": "vitest run test/csv-property.test.js --coverage.enabled=false",
    "test:types": "tsc -p test/types/tsconfig.json",
    "docs:api": "typedoc --options typedoc.json",
    "benchmark": "vitest bench --run test/benchmarks/performance-baseline.bench.mjs",
    "benchmark:csv:full": "node test/benchmarks/streaming-csv.mjs --preset=full",
    "benchmark:csv:memory": "node test/benchmarks/streaming-csv.mjs --preset=memory",
    "benchmark:csv:smoke": "node test/benchmarks/streaming-csv.mjs --preset=smoke --no-write",
    "benchmark:csv:stream": "node test/benchmarks/streaming-csv.mjs --preset=quick",
    "benchmark:json": "node test/benchmarks/streaming-json.mjs",
    "benchmark:runtime": "node test/benchmarks/runtime-parity.mjs",
    "benchmark:update": "node test/benchmarks/update-baseline.mjs",
    "lint": "oxlint --report-unused-disable-directives-severity=error --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write --ignore-path .oxfmtignore .",
    "format:check": "oxfmt --check --ignore-path .oxfmtignore ."
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "JSONStream": "1.3.5",
    "csv-parse": "7.0.2",
    "csv-parser": "3.2.1",
    "csv-stringify": "6.8.3",
    "fast-csv": "5.0.7",
    "highland": "2.13.5",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "papaparse": "5.5.4",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}